# Application
APP_NAME=HireFlow
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://hireflow:hireflow_dev@localhost:5432/hireflow

# Redis
REDIS_URL=redis://localhost:6379/0

# AI API Keys
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENAI_API_KEY=your-openai-api-key

# WeCom (Enterprise WeChat)
WECOM_CORP_ID=your-corp-id
WECOM_AGENT_ID=your-agent-id
WECOM_SECRET=your-secret
WECOM_TOKEN=your-token
WECOM_ENCODING_AES_KEY=your-encoding-aes-key

# ASR (Automatic Speech Recognition)
# Options: whisper, xunfei
ASR_PROVIDER=whisper
XUNFEI_APP_ID=your-xunfei-app-id
XUNFEI_API_KEY=your-xunfei-api-key
XUNFEI_API_SECRET=your-xunfei-api-secret

# ResumeSDK API
RESUMESDK_API_URL=http://www.resumesdk.com/api/parse
RESUMESDK_UID=your-resumesdk-uid
RESUMESDK_PWD=your-resumesdk-pwd

# File Upload
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=10485760

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
